{
  "expo": {
    "name": "Vine",
    "slug": "vine",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fgpsolutions.vine",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fgpsolutions.vine"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "vine",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vine needs access to your photos so you can choose a profile picture or share images.",
          "cameraPermission": "Vine uses the camera so you can take a profile picture or share photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 160,
          "backgroundColor": "#E1ECFA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8000",
      "eas": {
        "projectId": ""
      },
      "googleClientIds": {
        "ios": "",
        "android": "",
        "web": ""
      }
    }
  }
}

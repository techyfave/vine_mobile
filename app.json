{
  "expo": {
    "name": "Vine",
    "slug": "vine",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-mark.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fgpsolutions.vine",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E1ECFA",
        "foregroundImage": "./assets/images/logo-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fgpsolutions.vine",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "vine",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vine needs access to your photos so you can choose a profile picture or share images.",
          "cameraPermission": "Vine uses the camera so you can take a profile picture or share photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 160,
          "backgroundColor": "#E1ECFA"
        }
      ],
      "@sentry/react-native/expo",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://vine-api-staging.onrender.com",
      "eas": {
        "projectId": "fd9a9e85-60cd-41e0-9213-63ff969e7087"
      },
      "googleClientIds": {
        "ios": "",
        "android": "",
        "web": ""
      },
      "router": {},
      "sentryDsn": "https://df7819f9f9ef20664739f5181176c90a@o4512248555372544.ingest.de.sentry.io/4512248779309136"
    },
    "owner": "techyfave",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/fd9a9e85-60cd-41e0-9213-63ff969e7087"
    }
  }
}
